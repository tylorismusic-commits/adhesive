<https://github.com/tylorismusic-commits/adhesive#preset_broken>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/adhesive> ;
	rdfs:label "Broken Machine" ;
	rdfs:comment "Everything wrong at once: cassette before a pinned 10:1 compressor, full wow and iron." ;
	lv2:port
		[
			lv2:symbol "input_gain" ; pset:value 12
		] ,
		[
			lv2:symbol "glue_on" ; pset:value 1
		] ,
		[
